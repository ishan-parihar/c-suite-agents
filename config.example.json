{
  "$schema": "https://raw.githubusercontent.com/your-org/operant/main/src/config/schema.json",

  "llm": {
    "provider": "ollama",
    "baseUrl": "http://localhost:11434/v1",
    "apiKey": "",
    "model": "llama3.2:3b",
    "maxTokens": 4096,
    "temperature": 0.3,
    "timeoutMs": 180000,
    "contextTokens": 32768
  },

  "context": {
    "maxMessages": 50,
    "maxContextTokens": 32000,
    "compaction": {
      "auto": true,
      "prune": true,
      "reserved": 20000,
      "keepRecent": 6,
      "maxHistoryShare": 0.5,
      "timeoutSeconds": 900
    },
    "pruning": {
      "protectTokens": 40000,
      "minimumFree": 20000,
      "protectedTools": ["memory.consolidate"]
    }
  },

  "agents": {
    "defaultAutonomy": 3,
    "maxConcurrent": 5,
    "maxToolRounds": 10,
    "heartbeatInterval": "5m",
    "directToUser": true
  },

  "paths": {
    "lancedb": "/var/lib/operant/lancedb",
    "kanbanDb": "/var/lib/operant/kanban/kanban.db",
    "messagesDb": "/var/lib/operant/messages/messages.db",
    "agentOffices": "/etc/operant/agents",
    "logFile": "/var/log/operant/operant.log"
  },

  "telegram": {
    "botToken": "your-bot-token-from-botfather",
    "chatId": "your-chat-id-from-userinfobot"
  },

  "mcp": {
    "lifeos": {
      "type": "local",
      "command": ["node", "/opt/operant/build/lifeos-mcp-server.js"],
      "env": {
        "NOTION_API_KEY": "your-notion-api-key"
      },
      "enabled": true
    },
    "gog-cli-mcp": {
      "type": "local",
      "command": ["node", "/path/to/gog-cli-mcp/dist/index.js"],
      "env": {
        "GOG_MCP_CONFIG": "/path/to/gog-cli-mcp/config.json"
      },
      "enabled": true
    }
  },

  "logging": {
    "level": "info",
    "file": "/var/log/operant/operant.log",
    "maxFileBytes": 10485760
  }
}
