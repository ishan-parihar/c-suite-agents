# Operant Environment Configuration
# Copy this file to .env and fill in your values

# ===========================================
# Telegram Bot Configuration (REQUIRED)
# ===========================================
# Get token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Get your chat ID from @userinfobot on Telegram
TELEGRAM_CHAT_ID=your_chat_id_here

# ===========================================
# Native Agent Runtime Configuration
# ===========================================
# LLM provider: ollama, openai, anthropic, openrouter
AGENT_LLM_PROVIDER=ollama

# LLM base URL (OpenAI-compatible API)
# For Ollama: http://localhost:11434/v1
# For OpenAI: https://api.openai.com/v1
# For OpenRouter: https://openrouter.ai/api/v1
AGENT_LLM_BASE_URL=http://localhost:11434/v1

# API key (required for OpenAI/Anthropic/OpenRouter, not for Ollama)
OPENAI_API_KEY=
OLLAMA_API_KEY=

# Model to use for agent reasoning
# Ollama: llama3.1:8b, mistral:7b, qwen2.5:7b
# OpenAI: gpt-4o, gpt-4o-mini
AGENT_LLM_MODEL=llama3.1:8b

# Max tokens per response
AGENT_LLM_MAX_TOKENS=8192

# Temperature (0.0 = deterministic, 1.0 = creative)
AGENT_LLM_TEMPERATURE=0.3

# ===========================================
# Ollama Configuration (for embeddings)
# ===========================================
OLLAMA_HOST=http://localhost:11434
OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b

# ===========================================
# Data Directories
# ===========================================
LANCEDB_DIR=/var/lib/operant/lancedb
KANBAN_DB=/var/lib/operant/kanban/kanban.db
MESSAGES_DB=/var/lib/operant/messages/messages.db

# ===========================================
# Logging Configuration
# ===========================================
LOG_LEVEL=info
LOG_FILE=/var/log/operant/operant.log

# ===========================================
# Service Configuration
# ===========================================
OPERANT_USER=operant
OPERANT_GROUP=operant

# ===========================================
# Optional: Advanced Configuration
# ===========================================
NODE_ENV=production
MCP_SERVER_PORT=3000
