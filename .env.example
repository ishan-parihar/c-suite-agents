# Strategos Environment Configuration
# Copy this file to .env and fill in your values

# ===========================================
# Telegram Bot Configuration (REQUIRED)
# ===========================================
# Get token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Get your chat ID from @userinfobot on Telegram
TELEGRAM_CHAT_ID=your_chat_id_here

# ===========================================
# Ollama Configuration
# ===========================================
# Ollama API endpoint (default is local)
OLLAMA_HOST=http://localhost:11434

# Embedding model for semantic search
OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b

# ===========================================
# Data Directories
# ===========================================
# Vector database for memory embeddings
LANCEDB_DIR=/var/lib/strategos/lancedb

# SQLite database for Kanban boards
KANBAN_DB=/var/lib/strategos/kanban/kanban.db

# SQLite database for messages
MESSAGES_DB=/var/lib/strategos/messages/messages.db

# ===========================================
# Logging Configuration
# ===========================================
# Log level: debug, info, warn, error
LOG_LEVEL=info

# Log file path
LOG_FILE=/var/log/strategos/strategos.log

# ===========================================
# Service Configuration
# ===========================================
# System user (for production installs)
STRATEGOS_USER=strategos
STRATEGOS_GROUP=strategos

# ===========================================
# Optional: Advanced Configuration
# ===========================================
# Node environment
NODE_ENV=production

# MCP Server configuration
MCP_SERVER_PORT=3000
